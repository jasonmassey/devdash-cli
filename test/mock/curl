#!/usr/bin/env bash
# Mock curl for devdash API tests
# Intercepts curl calls, serves fixtures, logs requests

set -euo pipefail

# Parse curl arguments to extract what we need
method="GET"
outfile=""
write_format=""
body=""
url=""
auth=absent
redirect_limit="unset"
curl_config="enabled"
follow_redirect=false
first_arg=true

while [ $# -gt 0 ]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    -o) outfile="$2"; shift 2 ;;
    -w) write_format="$2"; shift 2 ;;
    -d) body="$2"; shift 2 ;;
    --data-binary)
      if [ "$2" = "@-" ]; then body=$(cat); else body="$2"; fi
      shift 2 ;;
    -H)
      case "$2" in Authorization:*|x-admin-secret:*) auth=present ;; esac
      shift 2 ;;
    -q) if [ "$first_arg" = true ]; then curl_config="disabled"; fi; shift ;;
    --max-redirs) redirect_limit="$2"; shift 2 ;;
    -L|--location) follow_redirect=true; shift ;;
    -s) shift ;;  # silent — ignore
    http://*|https://*) url="$1"; shift ;;
    *) shift ;;
  esac
  first_arg=false
done

if [ -n "${MOCK_CURL_LOG:-}" ]; then
  echo "${method} ${url} redirects=${redirect_limit} config=${curl_config} auth=${auth}" >> "${MOCK_CURL_LOG}.security"
  # Model a configured redirect: a credential would reach the foreign host if
  # redirects were followed. Never write the credential itself to the log.
  if [ -n "${MOCK_CURL_REDIRECT:-}" ] && [ "$auth" = present ] &&
     { [ "$redirect_limit" != 0 ] || [ "$curl_config" != disabled ] || [ "$follow_redirect" = true ]; }; then
    echo "foreign-origin credential forwarding possible" >> "${MOCK_CURL_LOG}.security"
  fi
fi

# Extract endpoint path: strip base URL, strip query params
endpoint="${url#*//*/api}"  # e.g., /beads?projectId=...
endpoint="${endpoint%%\?*}"  # strip query params

# Normalize path to fixture filename:
#   /beads          -> beads
#   /beads/UUID     -> beads_ID
#   /projects       -> projects
#   /projects/UUID  -> projects_ID
normalized="${endpoint#/}"  # strip leading /
# Replace UUID segments with ID
normalized=$(echo "$normalized" | sed -E 's/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/ID/g')
# Replace / with _
normalized="${normalized//\//_}"

fixture_name="${method}_${normalized}.json"
fixture_path="${MOCK_CURL_FIXTURE_DIR}/${fixture_name}"

# Check for companion .status file for non-200 responses
status_file="${fixture_path%.json}.status"
http_status="200"
if [ -f "$status_file" ]; then
  http_status=$(cat "$status_file")
fi

# Log the call (collapse body to single line for grep-ability)
if [ -n "${MOCK_CURL_LOG:-}" ]; then
  if [ -n "$body" ]; then
    compact_body=$(printf '%s' "$body" | tr '\n' ' ' | sed 's/  */ /g')
    if [ "$endpoint" = "/auth/cli/exchange" ]; then
      # Tests inspect the exchange payload separately; do not log verifier/code.
      echo "${method} ${endpoint}" >> "$MOCK_CURL_LOG"
      printf '%s\n' "$body" > "${MOCK_CURL_LOG}.exchange-body"
    else
      echo "${method} ${endpoint} ${compact_body}" >> "$MOCK_CURL_LOG"
    fi
  else
    echo "${method} ${endpoint}" >> "$MOCK_CURL_LOG"
  fi
  # Log raw URL for query-param assertions
  echo "${method} ${url}" >> "${MOCK_CURL_LOG}.urls"
fi

# Serve fixture
if [ -f "$fixture_path" ]; then
  if [ -n "$outfile" ]; then
    cp "$fixture_path" "$outfile"
  else
    cat "$fixture_path"
  fi
else
  # No fixture found — return empty JSON and 404
  http_status="404"
  if [ -n "$outfile" ]; then
    echo '{"error":"Not found"}' > "$outfile"
  else
    echo '{"error":"Not found"}'
  fi
fi

# Print http_code if -w '%{http_code}' was requested
if [ "$write_format" = '%{http_code}' ]; then
  printf '%s' "$http_status"
fi
